<?xml version="1.0" encoding="utf-8"?>
<!--
    The MVP keeps all data on this device (backup comes in a later version). allowBackup="false" turns off
    cloud backup; on Android 12+ device-to-device transfer ignores that flag, so every domain is excluded here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
