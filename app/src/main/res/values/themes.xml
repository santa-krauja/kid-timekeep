<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.KidTimekeep" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Launch theme: system splash screen, then swapped for Theme.KidTimekeep by installSplashScreen(). -->
    <style name="Theme.KidTimekeep.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFC94A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.KidTimekeep</item>
    </style>
</resources>
